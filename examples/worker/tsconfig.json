{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "rootDir": "../..",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2023", "WebWorker"]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/sdk/src/**/*.ts",
    "../../packages/internal/src/**/*.ts"
  ],
  "exclude": [
    "../../packages/sdk/src/node/**/*.ts",
    "../../packages/sdk/src/**/*.test.ts",
    "../../packages/internal/src/**/*.test.ts"
  ]
}
