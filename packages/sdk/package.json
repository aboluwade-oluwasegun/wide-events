{
  "name": "@wide-events/sdk",
  "version": "0.3.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboluwade-oluwasegun/wide-events.git"
  },
  "homepage": "https://github.com/aboluwade-oluwasegun/wide-events#readme",
  "bugs": {
    "url": "https://github.com/aboluwade-oluwasegun/wide-events/issues"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "import": "./dist/edge/index.js",
      "default": "./dist/edge/index.js"
    },
    "./instrumentation/pg": {
      "types": "./dist/node/instrumentation/pg.d.ts",
      "import": "./dist/node/instrumentation/pg.js",
      "default": "./dist/node/instrumentation/pg.js"
    },
    "./instrumentation/aws-sdk-v3": {
      "types": "./dist/node/instrumentation/aws-sdk-v3.d.ts",
      "import": "./dist/node/instrumentation/aws-sdk-v3.js",
      "default": "./dist/node/instrumentation/aws-sdk-v3.js"
    },
    "./instrumentation/ioredis": {
      "types": "./dist/node/instrumentation/ioredis.d.ts",
      "import": "./dist/node/instrumentation/ioredis.js",
      "default": "./dist/node/instrumentation/ioredis.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ioredis": "^5",
    "pg": "^8"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "ioredis": "^5.9.2",
    "pg": "^8.16.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json -f",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@wide-events/internal": "workspace:*",
    "zod": "4.3.6"
  }
}
